          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node) (rate(agent_node_duration_seconds_sum[$__rate_interval])) / sum by (node) (rate(agent_node_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
