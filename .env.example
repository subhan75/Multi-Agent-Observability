# Copy to .env and fill in. Never commit .env.
# No key? Leave it as is: the built-in mock AI works with no key and no cost (python run.py up).
# With a key, the page's "Live Gemini" option becomes available and is the default.
GOOGLE_API_KEY=your-gemini-api-key
# Options (all verified): gemini-4-argon (newest, flagship), gemini-3.8-flash, gemini-3.5-flash-lite (cheapest)
GEMINI_MODEL=gemini-4-argon

# LangSmith (Phase 6): records every AI step (prompts, replies, tool calls, tokens) and runs quality evaluations.
# Free account at https://smith.langchain.com . Leave tracing false and the project still works without it.
# PRIVACY: when tracing is on, customer questions and model answers are SENT to LangSmith.
# To record only the structure and timings, set both HIDE flags below to true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopsense
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your account is in the EU region
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false
# Model that grades answers in evaluations (cheap and fast is fine)
# JUDGE_MODEL=gemini-3.5-flash-lite

# Service URLs (defaults work for local runs)
ORDERS_URL=http://127.0.0.1:8001
INVENTORY_URL=http://127.0.0.1:8002
AGENTS_URL=http://127.0.0.1:8003

# ---- Learner edition (all optional) ----
# Force the model for every question: mock (built-in, free) or live (real Gemini).
# LLM_MODE=mock
# How long the mock AI "thinks" per call, in milliseconds: a range like 300-1200, a single number, or 0 for none.
# MOCK_LLM_LATENCY_MS=300-1200
# The "inject a problem" menu on the X-ray page (docker setup). Set to 0 to hide it.
# CHAOS_ENABLED=1
# Move a port if another program already uses it (docker setup).
# GRAFANA_PORT=3000
# GATEWAY_PORT=8000
